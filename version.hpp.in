#ifndef IPVIEW_VERSION_HPP
#define IPVIEW_VERSION_HPP

#include <cstdint>
#include <string_view>

namespace IPView::Version {

inline constexpr std::uint16_t Major   = @IPVIEW_VERSION_MAJOR@;
inline constexpr std::uint16_t Minor   = @IPVIEW_VERSION_MINOR@;
inline constexpr std::uint16_t Patch   = @IPVIEW_VERSION_PATCH@;
inline constexpr std::uint16_t Commits = @IPVIEW_VERSION_COMMITS@;

inline constexpr std::string_view String  = "@IPVIEW_VERSION_STRING@";
inline constexpr std::string_view AppName = "@IPVIEW_APP_NAME@";
inline constexpr std::string_view OrgName = "@IPVIEW_ORG_NAME@";
inline constexpr std::string_view OrgDomain = "@IPVIEW_ORG_DOMAIN@";
inline constexpr std::string_view DisplayName = "@IPVIEW_DISPLAY_NAME@";

} // namespace IPView::Version

// ── consteval accessors ──────────────────────────────────────────────────
//  These return compile-time-resolved views of the version metadata.
//  The function bodies are in version.cpp; the consteval return values
//  can be evaluated at compile time when invoked with a literal arg,
//  which Qt's metadata setters accept via QLatin1StringView.
namespace IPView {

consteval auto appName()        noexcept { return Version::AppName; }
consteval auto appVersion()     noexcept { return Version::String; }
consteval auto appOrgName()     noexcept { return Version::OrgName; }
consteval auto appOrgDomain()   noexcept { return Version::OrgDomain; }
consteval auto appDisplayName() noexcept { return Version::DisplayName; }

} // namespace IPView

#endif // IPVIEW_VERSION_HPP

